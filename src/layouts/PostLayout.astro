---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  tags?: string[];
}

const { title, description, pubDate, tags } = Astro.props;

const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={title} description={description} type="article">
  <article>
    <header>
      <p class="meta">
        <time datetime={pubDate.toISOString()}>{formattedDate}</time>
        {tags && tags.length > 0 && (
          <span class="tags">
            {tags.map((tag) => <span class="tag">{tag}</span>)}
          </span>
        )}
      </p>
      <h1>{title}</h1>
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  article {
    max-width: var(--measure);
    margin: 0 auto;
    padding: var(--space-5) var(--space-3);
  }

  header {
    margin-bottom: var(--space-4);
  }

  .meta {
    font-size: 0.9rem;
    color: var(--color-maroon-accent);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-1);
  }

  .tags {
    display: flex;
    gap: var(--space-1);
  }

  .tag::before {
    content: '#';
  }

  h1 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
  }

  .prose {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    line-height: 1.7;
  }

  .prose :global(h2),
  .prose :global(h3) {
    font-family: var(--font-sans);
    margin-top: var(--space-4);
  }

  .prose :global(p) {
    margin: 0 0 var(--space-3);
  }

  .prose :global(a) {
    color: var(--color-maroon-accent);
  }

  .prose :global(blockquote) {
    margin: var(--space-3) 0;
    padding-left: var(--space-3);
    border-left: 2px solid var(--color-border);
    font-style: italic;
  }

  .prose :global(code) {
    font-size: 0.9em;
    background: rgba(52, 7, 12, 0.06);
    padding: 0.15em 0.35em;
    border-radius: 3px;
  }

  .prose :global(pre) {
    padding: var(--space-2);
    overflow-x: auto;
    border-radius: 4px;
    background: rgba(52, 7, 12, 0.06);
  }

  .prose :global(pre code) {
    background: none;
    padding: 0;
  }

  .prose :global(hr) {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: var(--space-4) 0;
  }

  /* GFM footnotes render as an <hr> + <ol> inside a <section data-footnotes> at the
     bottom of the doc — style them as a quiet endnotes block until the sidenote
     treatment replaces this later. */
  .prose :global(section[data-footnotes]) {
    margin-top: var(--space-5);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
    font-size: 0.95rem;
  }
</style>
