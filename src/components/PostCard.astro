---
interface Props {
  slug: string;
  title: string;
  description: string;
  pubDate: Date;
}

const { slug, title, description, pubDate } = Astro.props;

const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article>
  <p class="date"><time datetime={pubDate.toISOString()}>{formattedDate}</time></p>
  <h2><a href={`/blog/${slug}/`}>{title}</a></h2>
  <p class="description">{description}</p>
</article>

<style>
  article {
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--color-border);
  }

  article:first-child {
    padding-top: 0;
  }

  .date {
    font-size: 0.9rem;
    color: var(--color-maroon-accent);
    margin-bottom: var(--space-1);
  }

  h2 {
    margin-bottom: var(--space-1);
    font-size: 1.35rem;
  }

  h2 a {
    color: var(--color-maroon);
    text-decoration: none;
  }

  h2 a:hover {
    color: var(--color-maroon-accent);
  }

  .description {
    margin: 0;
  }
</style>
