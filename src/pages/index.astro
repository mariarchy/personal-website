---
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialLink from '../components/SocialLink.astro';

const description =
  "Senior software engineer, jazz guitarist, and — as of late — prolific journaler. Currently pivoting into AI safety research.";
---

<BaseLayout title="mariarchy" description={description}>
  <section class="hero">
    <h1>.❀。• *₊°。 ❀°。 </h1>
    <p class="bio">
      Senior software engineer, jazz guitarist, and — as of
      late — prolific journaler (navel-gazer). Built platforms that have chugged billions of
      rows of data and more emissions than the country of Japan. Playing at jazz jams across
      London. Deep in a pivot into AI safety research.
    </p>
    <p class="links">
      <SocialLink href="https://linkedin.com/in/marissajliu" label="LinkedIn" />
      <SocialLink href="https://github.com/mariarchy" label="GitHub" />
    </p>
  </section>
</BaseLayout>

<style>
  :global(main) {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .hero {
    max-width: var(--measure);
    margin: 0 auto;
    padding: var(--space-6) var(--space-3);
  }

  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin-bottom: var(--space-3);
  }

  .bio {
    font-size: 1.15rem;
    margin-bottom: var(--space-4);
  }

  .links {
    display: flex;
    gap: var(--space-3);
    font-size: 1rem;
  }
</style>
